# Database connection
# When connecting from your host machine to Postgres inside Docker:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hms

# JWT & Authentication Configuration
JWT_SECRET_KEY=generate_your_own_secret_key_here_using_openssl_or_python
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini Cloud API Configuration (No local weights/models needed)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
