# Database connection
# When running the API on your host machine against the Docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hms

# JWT & Authentication (required, the app will not start without JWT_SECRET_KEY)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Google Gemini Cloud API (the AI concierge returns 503 without a key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: trace the AI concierge in Arize Phoenix (docker compose --profile observability up -d phoenix)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Optional: the model that GRADES answers in evals (use a different provider than Gemini)
# JUDGE_PROVIDER=openrouter
# JUDGE_MODEL=nvidia/nemotron-3.5-super-vl:free   (free models only)
# OPENROUTER_API_KEY=
# PHOENIX_PROJECT_NAME=hms                 # Phoenix project for real conversations (eval runs use hms-evals automatically)
# PHOENIX_REDACT_CONTENT=false             # true = keep timings/tokens/ids but drop all question/answer/document text
# PHOENIX_DOCKER_ENDPOINT=                 # set to http://phoenix:6006 to trace the app when it runs inside Docker

# Knowledge-base re-ranking: vector search fetches RERANK_CANDIDATES chunks, a local cross-encoder keeps the best ones.
# The model (~80 MB) downloads on first use into the fastembed cache. See evals/baselines/EXPERIMENTS.md #10.
# RERANK_ENABLED=true
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=20
# RERANK_MAX_CHARS=600

# Demo database autopilot: does a live hotel's daily work (check-ins, check-outs, room allocation, new bookings,
# reviews) so the demo data built by scripts/seed_demo_db.py never goes stale. Never runs on *_test databases.
# DEMO_AUTOPILOT=true
# DEMO_AUTOPILOT_INTERVAL_HOURS=3
